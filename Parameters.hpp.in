/**
 * @file Parameters.hpp
 *
 * @brief Simulation parameters. All these parameters are configured
 * automatically by CMake. Please don't touch this file!
 *
 * @author Bert Vandenbroucke (bv7@st-andrews.ac.uk)
 */
#ifndef PARAMETERS_HPP
#define PARAMETERS_HPP

#include <cstdint>
#include "OptionNames.hpp"

constexpr int OUTPUT_SNAP_STATUS = 100;
/*! @brief Minimum radius (in AU; set by the configuration). */
constexpr double RMIN_IN_AU = @rmin_in_au@;

/*! @brief Maximum radius (in AU; set by the configuration). */
constexpr double RMAX_IN_AU = @rmax_in_au@;

/*! @brief Default number of spherical shells (1D "cells") in between RMIN and
 *  RMAX (set by configuration). Can be overwritten by a command line
 *  parameter. */
constexpr uint32_t NCELL = @ncell@;

/*! @brief Polytropic index (set by the configuration). */
constexpr double GAMMA = @gamma@;

/*! @brief Maximum simulation time (in years; set by the configuration). */
constexpr double MAXTIME_IN_YR = @maxtime_in_yr@;

/*! @brief Number of snapshots to write during the simulation (set by the
 *  configuration). */
constexpr uint32_t NUMBER_OF_SNAPS = @number_of_snaps@;

/*! @brief Choice of external potential (set by the configuration). */
constexpr Potential POTENTIAL = @potential@;

/*! @brief Mass of the point mass (if POTENTIAL_POINT_MASS is selected; in
 *  solar masses; set by the configuration). */
constexpr double MASS_POINT_MASS_IN_MSOL = @mass_point_mass_in_msol@;

/*! @brief Central density of the Bondi set up (in kg m^-3; set by the
 *  configuration). */
constexpr double BONDI_DENSITY_IN_SI = @bondi_density_in_si@;

/*! @brief Time unit (in s; set by the configuration). */
constexpr double UNIT_TIME_IN_SI = @unit_time_in_si@;

/*! @brief Mass unit (in kg; set by the configuration). */
constexpr double UNIT_MASS_IN_SI = @unit_mass_in_si@;

/*! @brief Length unit (in m; set by the configuration). */
constexpr double UNIT_LENGTH_IN_SI = @unit_length_in_si@;

/*! @brief Courant factor for the time step criterion. */
constexpr double COURANT_FACTOR = @courant_factor@;

/*! @brief Type of Riemann solver to use (set by the configuration). */
constexpr Riemann RIEMANNSOLVER_TYPE =  @riemannsolver_type@;

/*! @brief Hydro scheme order (set by the configuration). */
constexpr int HYDRO_ORDER = @hydro_order@;

/*! @brief Time in between successive status outputs (in runtime s). */
constexpr double STATUS_UPDATE_INTERVAL = @status_update_interval@;

/*! @brief Thermal conductivity coefficient (set by configuration). */
constexpr double THERMAL_CONDUCTIVITY = @thermal_conductivity@;

/*! @brief Sound speed at infinity */
constexpr double SOUND_INFINITY_IN_SI = @sound_infinity_in_si@;

/*! @brief Density at infinity */
constexpr double RHO_INFINITY_IN_SI = @rho_infinity_in_si@;

constexpr double VELOCITY_INFINITY_IN_SI = @velocity_infinity_in_si@;

constexpr Coordinate COORDINATE_SYSTEM = @coord_system@;

constexpr BoundaryType BOUNDARY_TYPE = @boundary_type@;

#endif // PARAMETERS_HPP
